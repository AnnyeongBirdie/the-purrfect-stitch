# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode user-specific files
xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.moved-aside

# Build products
build/
DerivedData/
*.o
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# CocoaPods (in case you ever add it)
Pods/

# Misc
*.swp
*~

# Working documents (local-only; will inform README when ready)
DesignerAna_handoff.md
GAME_VOCABULARY.md
BossMinigame_prompt.md
RELICS.md
RIDDLE_BANK.md
MAGIC.md
ASSESSMENT*.md
# Prompt docs. Note the original *_prompt.md rule (below) is lowercase/singular
# and missed capitalized/plural names like BustUpPortrait_Prompts.md, so match
# those too.
*_Prompts.md

# Claude Code per-machine settings (absolute paths, machine-specific)
.claude/settings.local.json
*_prompt.md

# Diagnostic / assessment RESULTS reports (local-only, same rationale as the
# prompt docs above). Deliberately a wildcard so any future diagnostics pass
# is gitignored by convention rather than by remembering to add it.
*_results.md

# Raw-asset staging folder at repo root (local-only by design).
# Holds source PNG exports and downloaded SFX before they are imported into
# the asset catalog / DesignerAna/SoundEffects/, which ARE tracked and used by
# the build. Leading slash anchors to repo root so DesignerAna/SoundEffects/
# is NOT ignored. Back up _RawAssets/ separately — git does not version it.
/_RawAssets/

# Screenshots/ (no underscore) is TRACKED on purpose — README.md embeds those
# images and GitHub must be able to serve them. The underscore prefix is reserved
# for local-only folders, which is exactly why this one doesn't have it.
# Full-resolution originals live in the ignored /_RawAssets/screenshots_original/.

# Reference material for the owner's own use while designing a feature
# (tutorial screenshots, video stills, etc.) — not a shipped asset, same
# rationale as _RawAssets/ above. Back up separately if it matters.
/_ReferenceSamples/

# Blog drafts and working notes for velog posts (local-only).
/_BlogDrafts/

# Owner's own "explain it like I'm an intern" cheatsheets — learning
# material for the owner, not project documentation. Same leading-underscore,
# local-only convention as the folders above.
/_InternMode/
